# Copier ce fichier en .env.local puis remplir les valeurs. Ne jamais commiter .env.local.

# Connexion PostgreSQL (base créée avec scripts/sql/creer-base.sql)
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/maw3id
DATABASE_URL=

# Secret de signature des sessions : 32 caractères aléatoires minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Adresse de l'application
BETTER_AUTH_URL=http://localhost:3000

# Premier Administrateur plateforme (utilisé une seule fois par npm run base:creer-admin).
# Supprimer le mot de passe de ce fichier une fois le compte créé.
ADMIN_PLATEFORME_NOM=
ADMIN_PLATEFORME_EMAIL=
ADMIN_PLATEFORME_MOT_DE_PASSE=
